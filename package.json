{
  "name": "niulai-desktop-pet",
  "version": "1.6.0",
  "description": "支持 A 股、港股、美股的二维桌宠与桌面盯盘面板",
  "main": "main.js",
  "author": "Codex",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "node scripts/build-renderer.js && electron .",
    "test:modules": "node scripts/test-desktop-state.cjs && node scripts/test-crying-reaction.cjs && node scripts/test-mama-voice.mjs && node scripts/test-market-symbols.cjs && node scripts/test-us-quotes.cjs && node scripts/test-custom-quotes.cjs && node scripts/test-market-events.mjs && node scripts/test-feature-systems.mjs",
    "test:market": "node scripts/test-market-events.mjs",
    "test:regression": "npm run test:modules && node --test niulai-android/tests/core.test.mjs niulai-android/tests/motion.test.mjs",
    "test:single-instance": "node scripts/test-single-instance.cjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "test:experience": "node scripts/build-renderer.js && node scripts/test-desktop-experience.mjs",
    "test:motion": "node scripts/build-renderer.js && node scripts/test-desktop-motion.mjs",
    "test:colors": "node scripts/test-desktop-colors.cjs",
    "dist": "node scripts/build-renderer.js && electron-builder",
    "dist:win": "node scripts/build-renderer.js && electron-builder --win --publish never",
    "dist:installer": "node scripts/build-renderer.js && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/build-renderer.js && electron-builder --mac",
    "dist:mac:universal": "node scripts/build-renderer.js && electron-builder --mac --universal",
    "dist:mac:arm64": "node scripts/build-renderer.js && electron-builder --mac --arm64",
    "dist:mac:x64": "node scripts/build-renderer.js && electron-builder --mac --x64",
    "test:hq": "node scripts/test-desktop-hq.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.9"
  },
  "build": {
    "appId": "com.niulai.desktop-pet",
    "productName": "牛来盯盘",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "desktop.css",
      "renderer.bundle.js",
      "overlay.html",
      "overlay.css",
      "overlay.bundle.js",
      "main-modules/market-symbols.js",
      "main-modules/quote-parsers.js",
      "main-modules/quote-time.js",
      "main-modules/custom-quotes.cjs",
      "main-modules/desktop-state.cjs",
      "build/icon.png",
      "assets/2d/frames/webp/muyu-v1.webp",
      "assets/2d/frames/webp/scratch-v1.webp",
      "assets/2d/frames/webp/incense-v1.webp",
      "assets/2d/frames/webp/clap-v1.webp",
      "assets/2d/frames/webp/celebrate-v1.webp",
      "assets/2d/frames/webp/thumb-v1.webp",
      "assets/2d/frames/webp/cheek-v1.webp",
      "assets/2d/frames/webp/cover-v1.webp",
      "assets/2d/frames/webp/sleep-v2.webp",
      "assets/2d/frames/webp/look-v1.webp",
      "assets/2d/frames/webp/wave-v1.webp",
      "assets/2d/frames/webp/nod-v1.webp",
      "assets/2d/frames/webp/stretch-v1.webp",
      "assets/2d/frames/webp/lean-v1.webp",
      "assets/2d/frames/webp/idle-v1.webp",
      "assets/audio/niulai.mp3",
      "assets/audio/mama.mp3",
      "assets/audio/niulai-tap.wav",
      "docs/电脑版使用说明.md",
      "!node_modules/**/*",
      "main-modules/crying-reaction.cjs",
      "assets/2d/frames/hq/cover-00.webp",
      "assets/2d/frames/hq/cover-01.webp",
      "assets/2d/frames/hq/cover-02.webp",
      "assets/2d/frames/hq/cover-03.webp",
      "assets/2d/frames/hq/cover-04.webp",
      "assets/2d/frames/hq/cover-05.webp",
      "assets/2d/frames/hq/wave-00.webp",
      "assets/2d/frames/hq/wave-01.webp",
      "assets/2d/frames/hq/wave-02.webp",
      "assets/2d/frames/hq/wave-03.webp",
      "assets/2d/frames/hq/muyu-00.webp",
      "assets/2d/frames/hq/muyu-01.webp",
      "assets/2d/frames/hq/scratch-00.webp",
      "assets/2d/frames/hq/scratch-01.webp",
      "assets/2d/frames/hq/scratch-02.webp",
      "assets/2d/frames/hq/scratch-03.webp",
      "assets/2d/frames/hq/incense-00.webp",
      "assets/2d/frames/hq/incense-01.webp",
      "assets/2d/frames/hq/incense-02.webp",
      "assets/2d/frames/hq/incense-03.webp",
      "assets/2d/frames/hq/incense-04.webp",
      "assets/2d/frames/hq/incense-05.webp",
      "assets/2d/frames/hq/clap-00.webp",
      "assets/2d/frames/hq/clap-01.webp",
      "assets/2d/frames/hq/clap-02.webp",
      "assets/2d/frames/hq/celebrate-00.webp",
      "assets/2d/frames/hq/celebrate-01.webp",
      "assets/2d/frames/hq/celebrate-02.webp",
      "assets/2d/frames/hq/celebrate-03.webp",
      "assets/2d/frames/hq/thumb-00.webp",
      "assets/2d/frames/hq/thumb-01.webp",
      "assets/2d/frames/hq/thumb-02.webp",
      "assets/2d/frames/hq/thumb-03.webp",
      "assets/2d/frames/hq/thumb-04.webp",
      "assets/2d/frames/hq/cheek-00.webp",
      "assets/2d/frames/hq/cheek-01.webp",
      "assets/2d/frames/hq/cheek-02.webp",
      "assets/2d/frames/hq/cheek-03.webp",
      "assets/2d/frames/hq/cheek-04.webp",
      "assets/2d/frames/hq/cheek-05.webp",
      "assets/2d/frames/hq/sleep-00.webp",
      "assets/2d/frames/hq/sleep-01.webp",
      "assets/2d/frames/hq/sleep-02.webp",
      "assets/2d/frames/hq/sleep-03.webp",
      "assets/2d/frames/hq/sleep-04.webp",
      "assets/2d/frames/hq/sleep-05.webp",
      "assets/2d/frames/hq/sleep-06.webp",
      "assets/2d/frames/hq/sleep-07.webp",
      "assets/2d/frames/hq/look-00.webp",
      "assets/2d/frames/hq/look-01.webp",
      "assets/2d/frames/hq/look-02.webp",
      "assets/2d/frames/hq/look-03.webp",
      "assets/2d/frames/hq/look-04.webp",
      "assets/2d/frames/hq/look-05.webp",
      "assets/2d/frames/hq/nod-00.webp",
      "assets/2d/frames/hq/nod-01.webp",
      "assets/2d/frames/hq/nod-02.webp",
      "assets/2d/frames/hq/nod-03.webp",
      "assets/2d/frames/hq/stretch-00.webp",
      "assets/2d/frames/hq/stretch-01.webp",
      "assets/2d/frames/hq/stretch-02.webp",
      "assets/2d/frames/hq/stretch-03.webp",
      "assets/2d/frames/hq/stretch-04.webp",
      "assets/2d/frames/hq/stretch-05.webp",
      "assets/2d/frames/hq/lean-00.webp",
      "assets/2d/frames/hq/lean-01.webp",
      "assets/2d/frames/hq/lean-02.webp",
      "assets/2d/frames/hq/lean-03.webp",
      "assets/2d/frames/hq/lean-04.webp",
      "assets/2d/frames/hq/idle-00.webp",
      "assets/2d/frames/hq/idle-01.webp",
      "assets/2d/frames/hq/idle-02.webp",
      "assets/2d/frames/hq/idle-03.webp",
      "assets/2d/frames/hq/idle-04.webp",
      "assets/2d/frames/hq/idle-05.webp",
      "assets/2d/frames/hq/idle-06.webp",
      "assets/2d/frames/hq/idle-07.webp",
      "assets/2d/frames/hq/idle-08.webp",
      "main-modules/update-policy.cjs",
      "main-modules/update-checker.cjs"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "牛来盯盘",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Niulai-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "10.15"
    },
    "dmg": {
      "title": "${productName}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
