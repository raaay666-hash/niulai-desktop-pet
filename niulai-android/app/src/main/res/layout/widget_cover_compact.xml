<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
    android:background="@drawable/widget_cover_surface">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingEnd="4dp">
        <TextView android:id="@id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#CEDAD0" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_value" android:layout_width="match_parent" android:layout_height="34dp"
            android:textColor="#F7F2E8" android:textStyle="bold" android:textSize="28sp" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="30sp"
            android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
        <TextView android:id="@id/widget_note" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#CEDAD0" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B9CABE" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="66dp" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@id/widget_next" android:layout_width="match_parent" android:layout_height="44dp"
            android:gravity="center" android:textColor="#F7F2E8" android:textSize="13sp" android:background="@drawable/widget_cover_surface" />
        <TextView android:id="@id/widget_cover_stock" android:layout_width="match_parent" android:layout_height="44dp"
            android:gravity="center" android:text="下一只" android:textColor="#F7F2E8" android:textSize="13sp"
            android:contentDescription="切换到下一只自选" android:background="@drawable/widget_cover_surface" />
    </LinearLayout>
    <TextView android:id="@id/widget_scene" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageView android:id="@id/widget_chart" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageView android:id="@id/widget_bull" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
